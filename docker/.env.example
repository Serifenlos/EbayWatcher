# Vorlage für Docker Compose: als .env neben docker-compose.yml speichern und ausfüllen.
# In Portainer stattdessen dieselben Namen unter "Environment variables" eintragen.

# eBay Developer Program, Production-Keyset
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# Erster Login (das Passwort später in den Einstellungen ändern)
ADMIN_USER=admin
ADMIN_PASSWORD=

# Optional: Ordner für die Datenbank (Standard: ./data neben der Compose-Datei)
#DATA_PATH=/volume1/docker/ebay-watcher

# Optional: Besitzer des Datenordners (Synology: meist 1026 und 100)
#PUID=1000
#PGID=1000

# Notfall: Passwort auf ADMIN_PASSWORD zurücksetzen, danach wieder entfernen
#ADMIN_RESET=true
